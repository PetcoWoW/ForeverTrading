package-as: ForeverTrading

enable-nolib-creation: no

# the release notes on CurseForge and GitHub come from CHANGELOG.md (written for players)
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# the release holds the addon only: its .toc and .lua files
ignore:
  - .github
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - README.md
  - LICENSE
  - CHANGELOG.md
